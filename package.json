{
  "name": "visionbharat",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "author": "Arul Maria Agnes",
  "description": "VisionBharat — DataGenesis 2026 | India-Centric Dataset Engineering & From-Scratch Computer Vision Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && node electron/prepare-standalone.js && electron-builder --win",
    "electron:dist": "npm run build && node electron/prepare-standalone.js && electron-builder --win --publish never"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "lucide-react": "^1.34.0",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "^8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.2.4",
    "drizzle-kit": "0.31.10",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "wait-on": "^8.0.5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
